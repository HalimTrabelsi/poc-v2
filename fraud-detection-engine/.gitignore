# ============================================================
#  Fraud Detection Engine — .gitignore
#  Goal: push only source code + config, never heavy / generated artifacts
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# ---- Virtual environments ----
venv/
env/
.venv/
ENV/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*-checkpoint.ipynb

# ============================================================
#  DATA — never commit datasets (regenerate with scripts/)
# ============================================================
/ml/data/
ml/data/
*.csv
*.parquet
# keep small reference/example fixtures explicitly
!.gitkeep
!app/rules/**/*.yaml
!tests/**/*.csv

# ============================================================
#  TRAINED MODELS — large binaries, retrain instead of committing
# ============================================================
*.joblib
*.pkl
*.pickle
*.h5
*.onnx
app/models_saved/*.joblib
app/models_saved/*.pkl
app/models_saved/*.db
# keep the small *_metadata.json — they document the trained-model metrics
!app/models_saved/*metadata*.json

# ============================================================
#  GENERATED OUTPUTS — figures, reports, PDF, MLflow store
# ============================================================
ml/outputs/
ml/reports/
*.png
*.jpg
*.jpeg
*.pdf
mlruns/
mlflow.db
*.sqlite
*.sqlite3
*.db

# ============================================================
#  Secrets & environment
# ============================================================
.env
.env.local
.env.*.local
secrets/
credentials/
*.key
*.pem

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Test / tooling caches ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Logs & temp ----
*.log
*.tmp
*.bak
structure_fraud_engine.txt
