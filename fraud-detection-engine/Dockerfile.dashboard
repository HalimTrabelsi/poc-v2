FROM python:3.11-slim

WORKDIR /app

# Pinned versions — known compatible set, avoids pip resolver dead-ends.
# pyarrow is installed explicitly first because streamlit pulls it in as a
# transitive dep, and pip's resolver can fail to find a binary wheel for it.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir pyarrow==18.1.0 && \
    pip install --no-cache-dir \
        streamlit==1.40.2 \
        requests==2.32.3 \
        pandas==2.2.3 \
        plotly==5.24.1

COPY dashboard/ ./dashboard/

# Streamlit resolves project config from $CWD/.streamlit, but the file ships
# under dashboard/.streamlit — surface it at /app/.streamlit so the EY theme
# (yellow primaryColor, light base) actually applies at runtime.
RUN cp -r ./dashboard/.streamlit ./.streamlit

ENV PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/streamlit_app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
